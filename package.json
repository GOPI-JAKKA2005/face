{
  "name": "face-attend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build client --outDir ../dist",
    "lint": "eslint \"client/src/**/*.{js,jsx}\" server scripts --max-warnings 0",
    "models": "node scripts/downloadModels.js",
    "check:env": "node scripts/checkEnv.js",
    "admin:create": "node server/scripts/createAdmin.js",
    "backup": "node server/scripts/backupFirestore.js",
    "recompute:late": "node server/scripts/recomputeLate.js",
    "seed": "node server/scripts/seedDemo.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@fontsource/inter": "^5.0.21",
    "@fontsource/poppins": "^5.0.14",
    "@headlessui/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vladmandic/face-api": "^1.7.12",
    "autoprefixer": "^10.4.20",
    "browser-image-compression": "^2.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "firebase": "^10.13.0",
    "firebase-admin": "^12.5.0",
    "framer-motion": "^11.5.0",
    "postcss": "^8.4.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "swiper": "^11.1.10",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "vitest": "^2.0.5"
  }
}
